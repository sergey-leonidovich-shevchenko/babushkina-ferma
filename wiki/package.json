{
  "name": "moon-valley-wiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:content": "node scripts/prepare.mjs",
    "dev": "node scripts/prepare.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare.mjs && vue-tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "pnpm run build && pnpm run test",
    "start": "node scripts/launch.mjs"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "vue": "3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
