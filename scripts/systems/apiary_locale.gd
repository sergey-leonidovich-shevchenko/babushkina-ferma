## Показывает реальное продолжение алхимической цепочки выбранного пчелиного материала.
static func source_text(game: Node, kind: String) -> String:
	var outputs:={"bees":"bee_essence","honeycomb":"honey","beeswax":"wax_base","pollen":"pollen_powder","propolis":"propolis_tincture","wax_base":"bee_balm","bee_essence":"royal_tonic","pollen_powder":"bee_balm","propolis_tincture":"propolis_balm","honey_syrup":"royal_tonic"}
	return game.LocaleSystem.ui("apiary_alchemy",[game.inventory_item_name(outputs[kind])]) if outputs.has(kind) else ""
