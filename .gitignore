.DS_Store
.godot/
tools/*
!tools/build_forest_tree_atlas.py
assets/inbox/
tmp/
*.log

# Локальные концепты и воспроизводимые результаты нарезки уровня не входят в релиз.
/level_*.png
/level_*.png.import
/showcase_*.png
/showcase_*.png.import
/assets/game/tiles/*_preview.png
/assets/game/tiles/*_preview.png.import
/assets/game/environment/source/
/assets/generated/level_drafts/*
!/assets/generated/level_drafts/README_FIRST_LEVEL_MASTER.md
!/assets/generated/level_drafts/README_FIRST_LEVEL_TILING.md
!/assets/generated/level_drafts/first_level_fairytale_master_v1.png
!/assets/generated/level_drafts/first_level_ingame_preview.png
!/assets/generated/level_drafts/level_editor_ingame_preview.png
!/assets/generated/level_drafts/first_level_visual_master_v2.png
!/assets/generated/level_drafts/README_FIRST_LEVEL_VISUAL_V2.md
!/assets/generated/level_drafts/tree_stages_ingame_preview.png
