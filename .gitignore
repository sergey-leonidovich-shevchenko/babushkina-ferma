.DS_Store
.godot/
tools/*
!tools/build_forest_tree_atlas.py
!tools/build_village_prop_atlas.py
!tools/build_ui_kit.py
assets/inbox/
tmp/
*.log

# Локальные концепты и воспроизводимые результаты нарезки уровня не входят в релиз.
/level_*.png
/level_*.png.import
/showcase_*.png
/showcase_*.png.import
